## AI-Assisted

## Terminal step: on CI, free this flavor's per-flavor working raw image right
## after the flavor's image(s) are finalized, so disk is reclaimed and the upload
## does not carry it.

set -x
set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

true "INFO: Currently running script: ${BASH_SOURCE[0]} $*"

MYDIR="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" && pwd )"

cd "${MYDIR}"
cd ..
cd help-steps

source pre
source variables

main() {
   if [ "${dist_build_install_to_root:-}" = "true" ]; then
      true "${green}INFO: Skipping ${BASH_SOURCE[0]}, because dist_build_install_to_root is set to true.${reset}"
      return 0
   fi

   ## Only on CI. A local build keeps its raw for inspection.
   if [ ! "${CI:-}" = "true" ]; then
      true "${cyan}INFO: ${BASH_SOURCE[0]}: not CI, keeping the per-flavor build raw.${reset}"
      return 0
   fi

   ## Never delete the shared base here.
   if [ "${dist_build_base_image_role:-}" = "create" ]; then
      true "${cyan}INFO: ${BASH_SOURCE[0]}: --base-image-role create, leaving the shared base.${reset}"
      return 0
   fi

   if [ -n "${binary_image_raw_file:-}" ] && [ -f "${binary_image_raw_file}" ]; then
      true "${cyan}INFO: ${BASH_SOURCE[0]}: freeing per-flavor raw '${binary_image_raw_file}'.${reset}"
      safe-rm --force -- "${binary_image_raw_file}" || true
   fi
}

main "$@"
