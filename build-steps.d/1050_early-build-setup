## Early setup steps that must run before sanity checks. Note that this script
## must not source 'pre' or 'variables', and must not depend on early
## dependencies.

## style-ok: allow-echo -- the only 'echo' occurrences are inside strings.

## Unconditionally set on purpose.
DM_MYDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# shellcheck source=../packages/kicksecure/helper-scripts/usr/libexec/helper-scripts/check_runtime.bsh
source "${DM_MYDIR}/../packages/kicksecure/helper-scripts/usr/libexec/helper-scripts/check_runtime.bsh" || true
if ! declare -F was_executed >/dev/null; then
   printf '%s\n' "$0: ERROR: cannot source check_runtime.bsh!" >&2
   exit 1
fi

## Doesn't need an exit guard since we now know helper-scripts exists.
# shellcheck source=../packages/kicksecure/helper-scripts/usr/libexec/helper-scripts/package_installed_check.sh
source "${DM_MYDIR}/../packages/kicksecure/helper-scripts/usr/libexec/helper-scripts/package_installed_check.sh"

## The 'variables' aggregator must not be sourced this early (see above), but the
## early-dependency LIST is needed here to install it. Source only that single
## leaf fragment -- one source of truth, no duplicated package list, and no
## dependency on the full early-variables environment.
# shellcheck source=../variables.d/60_dependencies.bsh
source "${DM_MYDIR}/../variables.d/60_dependencies.bsh"

## Without 'pre' there is no error handler, so define the minimal one the
## standalone retry_run library needs (same as pbuilder-chroot-script-main).
error() {
   printf '%s\n' "$0: ERROR: $*" >&2
   exit 1
}

# shellcheck source=../help-steps/retry-run
source "${DM_MYDIR}/../help-steps/retry-run"

install_required_packages() {
   local required_package_item all_present="true"

   ## Skip trying to install the dependencies if they're all installed.
   # shellcheck disable=SC2086
   for required_package_item in ${dist_build_early_dependencies} ; do
      if ! pkg_installed "${required_package_item}" ; then
         true "INFO: early dependency '${required_package_item}' missing; installing the full early set."
         all_present="false"
         break
      fi
   done
   if [ "${all_present}" = "true" ]; then
      true "INFO: all early build dependencies already installed."
      return 0
   fi

   ## Using the build system's already existing APT sources list.
   ## As configured by the local system administrator.
   ##
   ## Not using the following command line options:
   #-o Dir::Etc::sourcelist="$dist_build_sources_list_primary" \
   #-o Dir::Etc::sourceparts="-" \
   ## Because dist_build_sources_list_primary requires approx.
   ##
   ## Only the minimal apt options, since 'variables' (DIST_APTGETOPT_*,
   ## SUDO_TO_ROOT, apt_unattended_opts) is not sourced here:
   ## - Error-Mode=any: a failed index fetch is an error, not a stale success.
   ## - --force-confold: keep the build host administrator's config files. List
   ##   form 'Dpkg::Options::=': a scalar 'Dpkg::Options=' is never passed to dpkg.
   ## - sudo resets the environment: keep the proxy variables (as SUDO_TO_ROOT
   ##   does) and set DEBIAN_FRONTEND via env.
   local apt_options=( -o APT::Update::Error-Mode=any )
   ## The commas are sudo's list syntax, one argument.
   # shellcheck disable=SC2054
   local sudo_command=( sudo --non-interactive --preserve-env=http_proxy,https_proxy -- )

   retry_run -- \
   "${sudo_command[@]}" \
      apt-get \
         "${apt_options[@]}" \
         update

   # shellcheck disable=SC2086
   retry_run -- \
   "${sudo_command[@]}" \
      env DEBIAN_FRONTEND=noninteractive \
      apt-get \
         "${apt_options[@]}" \
         -o Dpkg::Options::=--force-confold \
         --no-install-recommends \
         --yes \
         install \
         ${dist_build_early_dependencies}
}

main() {
   set -x
   set -o errexit
   set -o nounset
   set -o pipefail
   set -o errtrace
   shopt -s inherit_errexit
   shopt -s shift_verbose
   export LC_ALL=C

   true "INFO: Currently running script: ${BASH_SOURCE[0]} $*"

   cd "${DM_MYDIR}"
   cd ..

   install_required_packages
}

if was_executed "${BASH_SOURCE[0]}"; then
   main "$@"
fi
