set -x
set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

true "INFO: Currently running script: ${BASH_SOURCE[0]} $*"

MYDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

cd "${MYDIR}"
cd ..
cd help-steps

source pre
source variables

export_utm_packages() {
   ## create folder structure for UTM
   ## move image file
   ## copy configs
   mkdir --parents "${binary_image_utm_folder}/Data"
   ## Ship qcow2, not raw:
   ## - qcow2 is UTM's own default drive format.
   ## - a raw image on an APFS host triggers an unaligned-discard error via
   ##   VirtIO TRIM on Apple Silicon; qcow2 lets QEMU own sparsity instead of
   ##   relying on APFS hole-punching.
   ## 4400_convert-raw-to-qcow2 produced ${binary_image_qcow2_file} (it runs for
   ## --target utm too). Same build folder -> mv is a cheap rename.
   local bundle_qcow2_file
   bundle_qcow2_file="${binary_image_utm_folder}/Data/${VMNAME}.qcow2"
   if [ "${dist_build_qcow2:-}" = "true" ]; then
      ## --target qcow2 also requested: the standalone qcow2 is a deliverable,
      ## so copy (leave it in place). Copy is also idempotent / CI-testable.
      cp -- "${binary_image_qcow2_file}" "${bundle_qcow2_file}"
   elif [ -e "${binary_image_qcow2_file}" ]; then
      ## utm-only: the qcow2 is just an intermediate 4400 made for us; move it
      ## into the bundle -- no stray artifact, no second full-image copy.
      mv -- "${binary_image_qcow2_file}" "${bundle_qcow2_file}"
   elif [ ! -e "${bundle_qcow2_file}" ]; then
      ## Rerun-safe: a mv on an earlier run already placed it in the bundle.
      ## Neither source nor bundle copy present -> the qcow2 was never built.
      error "qcow2 image missing: neither ${binary_image_qcow2_file} nor ${bundle_qcow2_file} exists"
   fi
   cp -- "${source_utm_file}" "${binary_image_utm_folder}/config.plist"

   ## Fill in correct architecture and target in UTM template files.
   local utm_arch
   local utm_target
   utm_arch="$(dist_build_arch_to_qemu_machine "${dist_build_target_arch}")"
   if [ "${dist_build_target_arch:-}" = "arm64" ]; then
      utm_target="virt"
   else
      utm_target="q35"
   fi

   ${str_replace_tool} "_ARCH_"   "${utm_arch}"   "${binary_image_utm_folder}/config.plist"
   ${str_replace_tool} "_TARGET_" "${utm_target}" "${binary_image_utm_folder}/config.plist"

   ## Fill in correct flavor for disk image filename and VM name as it appears on UTM.
   ${str_replace_tool} "_FLAVOR_" "${VMNAME}" "${binary_image_utm_folder}/config.plist"

   ## TODO: This should be moved to dm-prepare-release.
   ##       But good enough to keep it here as long as UTM builds are not redistributed.
   ##
   ## Compress the utm folder into one archive respecting sparse (null) bytes
   ## dm-prepare-release also uses tar. Using similar options here.
   tar \
      --create \
      --verbose \
      --owner=0 --group=0 --numeric-owner \
      --mode=go=rX,u+rw,a-s \
      --sort=name \
      --sparse \
      --mtime='2015-10-21 00:00Z' \
      --gzip \
      --file="${dist_binary_build_folder}/${VMNAME}.utm.tar.gz" \
      "${binary_image_utm_folder}"

   ## Safe disk space.
   safe-rm -r -- "${binary_image_utm_folder}"
}

main() {
   if [ "${dist_build_utm:-}" = "true" ]; then
      export_utm_packages
   else
      true "${green}INFO: Skipping ${BASH_SOURCE[0]}, because not using --target utm.${reset}"
   fi
}

main "$@"
