## style-ok: no-strict
## Sourced build library for help-steps/variables. Strict-mode is owned by the
## caller (help-steps/variables sets errexit/nounset/pipefail), so these helpers
## stay strict-free and can be sourced by a unit test and called directly without
## inheriting strict-mode into the test shell. 'return', never 'exit'.
##
## check_variable_name (helper-scripts strings.bsh) must be in scope at call time;
## the caller sources strings.bsh, as does the unit test.

set_default_variable() {
  local var_name var_content
  var_name="$1"
  var_content="$2"

  ## Checking the variable name before using printf -v or "${!var_name:-}".
  ## This might not be strictly necessary, but it shields against future bugs.
  check_variable_name "${var_name}" || return 1

  if [ -z "${!var_name:-}" ]; then
    #printf "%s\n" "INFO: Variable '$var_name' is already set? No. - Setting: $var_name='$var_content'"
    ## Use 'printf -v' instead of 'eval' so single quotes or other shell
    ## metacharacters inside "$var_content" are stored literally and cannot
    ## be reinterpreted by the shell parser.
    printf -v "${var_name}" '%s' "${var_content}"
    return 0
  fi
  #printf "%s\n" "INFO: Variable '$var_name' is already set? Yes. - Already: $var_name='${!var_name}'"
}

## Derive the single "other VM" unified-image path for a unified (multi-VM) build.
##
## NOTE: 'binary_image_{raw,qcow2}_file_for_unified' reads like a list but
## is singular by construction. For a unified (multi-VM) build such as
## Whonix, 'vm_names_to_be_exported' contains exactly two names (Gateway
## and Workstation); the 'continue' below skips the one matching the
## current 'dist_build_type_long', leaving exactly one "other" VM whose
## image path is stored here. Consumers (dm-prepare-release,
## 1200_prepare-build-machine) treat it as a single path - e.g. the
## error message reads "missing other VM for unified builds". Do not
## convert this to an array without updating those callers.
##
## Uses ambient build variables: vm_names_to_be_exported, dist_build_type_long,
## dist_binary_build_folder, dist_build_version, target_architecture_pretty_name.
derive_unified_image_paths() {
   local vm_name_item_to_be_exported vm_name_item_lower dist_build_type_long_lower

   ## 'none' sentinel (set for a non-unified build such as --flavor source): there
   ## is no "other VM" to name, so leave binary_image_{raw,qcow2}_file_for_unified
   ## UNSET rather than deriving a nonsensical '.../none-<ver>.<arch>.raw' path.
   ## (Only unified/workstation builds consume these vars; on other single-VM
   ## builds the substring skip below may or may not fire, but the value is unread.)
   if [ "${vm_names_to_be_exported:-}" = "none" ]; then
      return 0
   fi

   # shellcheck disable=SC2086
   for vm_name_item_to_be_exported in ${vm_names_to_be_exported} ; do
      ## Compare case-insensitively but as exact substrings, not regex, to
      ## avoid regex metacharacters in 'dist_build_type_long' matching
      ## unintended VM names.
      vm_name_item_lower="${vm_name_item_to_be_exported,,}"
      dist_build_type_long_lower="${dist_build_type_long,,}"
      case "${vm_name_item_lower}" in
         *"${dist_build_type_long_lower}"*)
            continue
            ;;
      esac
      set_default_variable binary_image_raw_file_for_unified "${dist_binary_build_folder}/${vm_name_item_to_be_exported}-${dist_build_version}.${target_architecture_pretty_name}.raw"
      set_default_variable binary_image_qcow2_file_for_unified "${dist_binary_build_folder}/${vm_name_item_to_be_exported}-${dist_build_version}.${target_architecture_pretty_name}.qcow2"
   done
}

## {{ Configuration-precedence layering.
##
## The intended ladder is: code defaults < buildconfig.d/--conffile < environment
## < command-line. But buildconfig.d is sourced LATE (its derivations read
## already-resolved inputs), so an unconditional assignment there would otherwise
## outrank a CLI flag or an env value. These helpers capture the environment and
## CLI layers, then re-apply them over exactly the variables buildconfig.d
## CHANGED -- restoring env/CLI precedence without disturbing buildconfig.d's own
## derivations or the intentional module assignments.
##
## Whitelist-free by construction: shell/system variables (PATH, HOME, LC_*, ...)
## are never re-applied because buildconfig.d does not change them, so they never
## enter the "changed by config" set. Scalars only -- arrays (DIST_APTGETOPT,
## ...) are accumulators, not user inputs, and are left to their normal building.

## Snapshot every SCALAR variable's current value into the associative array
## named by $1 (created global). Arrays and the layer snapshots themselves are
## skipped.
dm_layer_capture() {
   local dm_lc_name dm_lc_line dm_lc_flags dm_lc_dump
   declare -gA "$1"
   local -n dm_lc_dst="$1"
   dm_lc_dst=()
   ## ONE 'declare -p' (no per-variable subprocess -- that was O(vars) forks and
   ## far too slow across every build combo). Fed via a here-string, NOT process
   ## substitution '< <(...)', so the loop runs in THIS shell and the assignments
   ## persist. Keep only scalar lines ('declare -<flags> name="..."'); skip flags
   ## carrying 'a'/'A' (arrays), for which the indirect "${!name}" scalar read
   ## would error. The value is read by indirect expansion, not parsed from the
   ## (shell-quoted) declare -p text.
   dm_lc_dump="$(declare -p)"
   while IFS= read -r dm_lc_line; do
      [[ "${dm_lc_line}" =~ ^declare\ -([a-zA-Z-]+)\ ([A-Za-z_][A-Za-z0-9_]*)= ]] || continue
      dm_lc_flags="${BASH_REMATCH[1]}"
      ## Skip arrays ('a'/'A' -- indirect scalar read errors) and readonly ('r' --
      ## BASHOPTS/SHELLOPTS/EUID/UID/PPID/... which re-apply cannot assign anyway).
      case "${dm_lc_flags}" in
         *a*|*A*|*r*)
            continue
            ;;
      esac
      dm_lc_name="${BASH_REMATCH[2]}"
      ## Skip the layer snapshots themselves and bash dynamic/special scalars
      ## (they change every read; re-applying them is meaningless and unsafe).
      case "${dm_lc_name}" in
         dm_layer_*|dm_lc_*|dm_lr_*|dm_cc_*)
            continue
            ;;
         RANDOM|SRANDOM|SECONDS|LINENO|BASHPID|EPOCHSECONDS|EPOCHREALTIME|BASH_COMMAND|BASH_SUBSHELL|_)
            continue
            ;;
      esac
      dm_lc_dst["${dm_lc_name}"]="${!dm_lc_name:-}"
   done <<< "${dm_lc_dump}"
}

## Compute the CLI layer: scalars that parse-cmd changed, i.e. differ between the
## pre-parse-cmd snapshot (dm_layer_env, also the environment layer) and the
## post-parse-cmd snapshot (dm_layer_after_pc).
dm_layer_compute_cli() {
   local dm_cc_name
   declare -gA dm_layer_cli
   dm_layer_cli=()
   for dm_cc_name in "${!dm_layer_after_pc[@]}"; do
      if [ ! "${dm_layer_after_pc[${dm_cc_name}]}" = "${dm_layer_env[${dm_cc_name}]:-}" ]; then
         dm_layer_cli["${dm_cc_name}"]="${dm_layer_after_pc[${dm_cc_name}]}"
      fi
   done
}

## Re-apply env + CLI precedence over buildconfig.d. For each scalar buildconfig.d
## CHANGED (differs between dm_layer_preconfig and dm_layer_postconfig): restore
## the CLI value if the user passed one, else the environment value if the user
## exported one; otherwise leave buildconfig.d's value (it outranks a code
## default). Only config's own changes are touched.
dm_layer_reapply() {
   local dm_lr_name
   for dm_lr_name in "${!dm_layer_postconfig[@]}"; do
      if [ "${dm_layer_postconfig[${dm_lr_name}]}" = "${dm_layer_preconfig[${dm_lr_name}]:-}" ]; then
         continue
      fi
      ## Guard the dynamic name before 'printf -v' (a name like 'x[$(cmd)]' would
      ## execute cmd). Names come from declare -p and are already identifier-only,
      ## but check explicitly as set_default_variable does.
      check_variable_name "${dm_lr_name}" || continue
      if [ -n "${dm_layer_cli[${dm_lr_name}]+set}" ]; then
         printf -v "${dm_lr_name}" '%s' "${dm_layer_cli[${dm_lr_name}]}"
      elif [ -n "${dm_layer_env[${dm_lr_name}]+set}" ]; then
         printf -v "${dm_lr_name}" '%s' "${dm_layer_env[${dm_lr_name}]}"
      fi
   done
}

## Drop the snapshots so they do not leak into the build environment / a variable
## snapshot dump.
dm_layer_cleanup() {
   unset dm_layer_env dm_layer_after_pc dm_layer_cli dm_layer_preconfig dm_layer_postconfig
}

## }}
