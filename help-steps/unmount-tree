## AI-Assisted

## Unmount every mount point strictly UNDER a tree, deepest first.

## Deliberately STANDALONE: it does not source 'pre' or 'variables', so it
## needs no populated build environment and can be driven directly by a test.
## Callers that have the build environment pass the tree as an argument and
## prefix '${SUDO_TO_ROOT}'.
##
## STRICT submounts only ('<tree>/...'), never '<tree>' itself: the tree's own
## root mount belongs to the caller. unchroot-raw sweeps '$CHROOT_FOLDER'
## between install-packages' chroot cycles, and the ext4 root that mount-raw
## put there must stay mounted until unmount-raw removes it. Callers that do
## want the tree's own mount gone unmount it themselves ('unmount-helper').
##
## Fails CLOSED: an unreadable mount table, or any mount still present under
## the tree after the sweep, is a non-zero exit. Callers follow this with a
## recursive delete, where a leftover bind mount is what lets the delete
## escape the tree.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

true "INFO: Currently running script: ${BASH_SOURCE[0]} $*"

## Standalone by contract, so helper-scripts' 'log'/'die' are out of reach;
## this matches 'umount_kill.sh', the other standalone script here.
unmount_tree_die() {
   printf '%s\n' "$0: ERROR: $1" >&2
   exit 1
}

## Set by 'collect_mounts_under_tree' to the decoded mount points found.
## An array, not newline-separated output, because a mount point may itself
## contain a newline.
mounts_under_tree=()

## Collect the mount points strictly under '$1', deepest first.
##
## Reads '/proc/self/mountinfo' rather than asking 'findmnt': findmnt ESCAPES
## a mount point containing whitespace and offers no way to decode it again
## ('--raw' renders a space as '\x20', '--list' renders a tab as '\x09'), so
## the escaped form reaches 'umount' verbatim and the unmount fails while
## looking like a clean sweep. mountinfo's field 5 carries the kernel's own
## octal escaping -- ' ', '\t', '\n' and '\' become '\040', '\011', '\012',
## '\134' (proc_pid_mountinfo(5)) -- which 'printf %b' decodes exactly.
##
## Sorting is done on the ENCODED form: it is newline-free, so a line-based
## sort cannot split one entry into two, and a child path is always its
## parent plus '/<name>', a strict string extension. Reverse ordering
## therefore puts every child ahead of its parent whatever the names are.
collect_mounts_under_tree() {
   local tree mountinfo_line encoded_list encoded_sorted encoded_line decoded_path
   local field_mount_id field_parent_id field_major_minor field_root field_mount_point

   tree="$1"
   mounts_under_tree=()

   if [ ! -r /proc/self/mountinfo ]; then
      return 1
   fi

   encoded_list=""
   while read -r field_mount_id field_parent_id field_major_minor field_root field_mount_point mountinfo_line; do
      printf -v decoded_path '%b' "${field_mount_point}"
      case "${decoded_path}" in
         "${tree}"/*)
            encoded_list+="${field_mount_point}"$'\n'
            ;;
      esac
   done < /proc/self/mountinfo

   if [ -z "${encoded_list}" ]; then
      return 0
   fi

   encoded_sorted="$(printf '%s' "${encoded_list}" | LC_ALL=C sort --reverse)" || return 1

   while IFS="" read -r encoded_line; do
      if [ -z "${encoded_line}" ]; then
         continue
      fi
      printf -v decoded_path '%b' "${encoded_line}"
      mounts_under_tree+=( "${decoded_path}" )
   done <<< "${encoded_sorted}"
}

main() {
   local file_system_object real_path mount_point attempt_number remaining_list

   while :
   do
      case "${1:-}" in
         --)
            shift
            break
            ;;
         *)
            break
            ;;
      esac
   done

   file_system_object="${1:-}"

   if [ -z "${file_system_object}" ]; then
      unmount_tree_die "no parameter given!"
   fi

   ## An empty or '/' tree would make the '"${tree}"/*' pattern below
   ## degenerate to '/*' and match every mount on the system.
   if [ "${file_system_object}" = "/" ]; then
      unmount_tree_die "file_system_object is set to / which is probably wrong (would unmount the whole system)!"
   fi

   if ! test -e "${file_system_object}" ; then
      true "INFO: '${file_system_object}' does not exist, nothing can be mounted under it, ok."
      return 0
   fi

   ## mountinfo reports canonical kernel paths, so the tree has to be
   ## canonicalized too or a symlinked build folder matches nothing.
   real_path="$(realpath -- "${file_system_object}")" \
      || unmount_tree_die "could not canonicalize file_system_object '${file_system_object}'."

   if [ -z "${real_path}" ] || [ "${real_path}" = "/" ]; then
      unmount_tree_die "file_system_object '${file_system_object}' canonicalized to '${real_path}', refusing."
   fi

   ## Repeat the sweep: '--lazy' detaches immediately, but a mount that was
   ## created under the tree while the previous pass ran is only visible to
   ## the next one.
   for attempt_number in 1 2 3; do
      collect_mounts_under_tree "${real_path}" \
         || unmount_tree_die "could not read the mount table, refusing to report '${real_path}' as unmounted."

      if [ "${#mounts_under_tree[@]}" = "0" ]; then
         break
      fi

      ## '|| true' per target so one stubborn mount does not skip the rest;
      ## whether the sweep actually succeeded is decided by the verification
      ## below, not by these exit codes.
      for mount_point in "${mounts_under_tree[@]}"; do
         umount --lazy --force -- "${mount_point}" \
            || printf '%s\n' "$0: WARNING: umount '${mount_point}' failed, attempt ${attempt_number}." >&2
      done

      sync
   done

   collect_mounts_under_tree "${real_path}" \
      || unmount_tree_die "could not read the mount table, refusing to report '${real_path}' as unmounted."

   if [ ! "${#mounts_under_tree[@]}" = "0" ]; then
      remaining_list="$(printf '%s\n' "${mounts_under_tree[@]}")"
      printf '%s\n' "$0: ERROR: mounts still present under '${real_path}' after the sweep:" >&2
      printf '%s\n' "${remaining_list}" >&2
      unmount_tree_die "do NOT delete '${real_path}' -- a recursive delete would cross the mount(s) listed above."
   fi

   true "INFO: no mounts left under '${real_path}', ok."
}

main "$@"
