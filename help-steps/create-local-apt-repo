set -x
set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

true "INFO: Currently running script: ${BASH_SOURCE[0]} $*"

MYDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

source "${MYDIR}/pre"
source "${MYDIR}/variables"

## Single source of truth for the local apt repo deb822 stanza.
source "${source_code_folder_dist}/packages/kicksecure/helper-scripts/usr/libexec/helper-scripts/local-apt-repo-sources.bsh"

main() {
   ## local_apt_repo_mount_folder Example:
   ## /mnt/local-apt-repo

   ## dist_sources_list_temp_build_folder Example:
   ## /var/lib/whonix/sources_temp_list.d

   ## dist_apt_repository_folder Examples:
   ## /home/user/derivative-binary/aptrepo_local/kicksecure
   ## /home/user/derivative-binary/aptrepo_local/whonix

   ${SUDO_TO_ROOT} safe-rm --force -- "${dist_sources_list_temp_initial_deb_sources_list}"

   true "derivative_name_list: ${derivative_name_list}"

   for derivative_name_item in ${derivative_name_list} ; do
      derivative_repository_name="${derivative_name_item}"
      ## Not required:
      #export derivative_repository_name

      ## sets: dist_apt_repository_folder
      set_dist_build_reprepro_folder_options

      ${SUDO_TO_ROOT} mkdir --parents -- "${CHROOT_FOLDER}/${local_apt_repo_mount_folder}/${derivative_name_item}"
      ${SUDO_TO_ROOT} mkdir --parents -- "${CHROOT_FOLDER}/${dist_sources_list_temp_build_folder}"

      true "dist_sources_list_temp_initial_deb_sources_list: ${dist_sources_list_temp_initial_deb_sources_list}"
      true "sources_list_target_build_remote_derivative: ${sources_list_target_build_remote_derivative:-}"
      true "build_remote_derivative_pkgs: ${build_remote_derivative_pkgs:-}"

      if [ "${build_remote_derivative_pkgs:-}" = "true" ]; then
         ${SUDO_TO_ROOT} cp -- "${source_code_folder_dist}/packages/kicksecure/usability-misc/usr/bin/repo-add-dist" "${CHROOT_FOLDER}/${local_apt_repo_mount_folder}/repo-add-dist"

         true "INFO: running repo-add-dist... It is supposed to create ${dist_sources_list_temp_initial_deb_sources_list} ..."
         ## Variable 'codename' is irrelevant because setting variable 'sources_list_build_remote_derivative'.
         chroot_run \
            env \
               codename="${dist_build_apt_codename}" \
               sources_list_target_folder_build_remote_derivative="${dist_sources_list_temp_build_folder}" \
               sources_list_target_build_remote_derivative="${dist_sources_list_temp_build_file}" \
               sources_list_build_remote_derivative="${sources_list_build_remote_derivative}" \
               apt_target_key_derivative="${apt_target_key_derivative}" \
               apt_source_key_temp_folder_derivative="${dist_sources_list_temp_apt_key_folder}" \
               apt_source_key_derivative="${dist_sources_list_temp_apt_key_folder}/derivative-temp-by-create-local-apt-repo.asc" \
               bash -x -- "/${local_apt_repo_mount_folder}/repo-add-dist"
         true "INFO: done with repo-add-dist."
      else
         ## A derivative not built into the local store has no repo dir -- common
         ## with the FHS /srv store (fresh per machine) vs the old persistent
         ## ~/derivative-binary that kept every derivative's dir across builds.
         ## Nothing to mount for it, so skip rather than hard-fail the whole build.
         if [ ! -d "${dist_apt_repository_folder}" ]; then
            true "INFO: no local repo for ${derivative_name_item} at ${dist_apt_repository_folder}; skipping."
            continue
         fi
         ## If $dist_apt_repository_folder is owned by user and host umask is 027 (others ("o") cannot read),
         ## then the unprivileged APT downloaded cannot access this folder.
         chmod --recursive o+r -- "${dist_apt_repository_folder}"
         find "${dist_apt_repository_folder}" -type d -exec chmod o+rx -- {} +

         ## Mount our local apt repository inside the image (or machine).
         ${SUDO_TO_ROOT} mount --bind -- "${dist_apt_repository_folder}" "${CHROOT_FOLDER}/${local_apt_repo_mount_folder}/${derivative_name_item}"

         ## Append this derivative's stanza (the shared generator is the single
         ## source of truth). A leading blank line keeps multiple stanzas separate.
         {
            printf '%s\n' ''
            local_apt_repo_sources_stanza "file:/${local_apt_repo_mount_folder}/${derivative_name_item}" "${dist_build_apt_codename}"
         } | ${SUDO_TO_ROOT} tee --append -- "${dist_sources_list_temp_initial_deb_sources_list}" >/dev/null
         ${SUDO_TO_ROOT} chmod o+r -- "${dist_sources_list_temp_initial_deb_sources_list}"
      fi
   done

   ## Copy which (frozen) sources file will be used for building Kicksecure / Whonix into the image (or machine).
   ${SUDO_TO_ROOT} cp -- "${dist_build_sources_list_primary}" "${CHROOT_FOLDER}/${dist_sources_list_temp_build_folder}/build_sources.sources"
   ${SUDO_TO_ROOT} chmod o+r -- "${CHROOT_FOLDER}/${dist_sources_list_temp_build_folder}/build_sources.sources"

   ## For debugging / Info.
   ls -la -- "${CHROOT_FOLDER}/${local_apt_repo_mount_folder}"
   ls -la -- "${CHROOT_FOLDER}/${dist_sources_list_temp_build_folder}"

   ## For debugging / Info.
   true "(1/2) ${cyan}${CHROOT_FOLDER}/${dist_sources_list_temp_build_folder}/build_sources.sources${reset}:"
   cat -- "${CHROOT_FOLDER}/${dist_sources_list_temp_build_folder}/build_sources.sources"

   ## For debugging / Info.
   true "(2/2) ${cyan}dist_sources_list_temp_initial_deb_sources_list${reset}: ${dist_sources_list_temp_initial_deb_sources_list}"
   cat -- "${dist_sources_list_temp_initial_deb_sources_list}"
}

main "$@"
