## AI-Assisted

## Miscellaneous helper functions that don't warrent their own library. Some of
## these are shared between multiple scripts, some have only been split out for
## testing purposes. Not all of them are pure functions, by design.
## help-steps/variables sources this.
##
## style-ok: no-strict -- sourced library.

resolve-partition-uuid() {
   ## Print the UUID of a partition specified by device name.
   local partition_name lsblk_output name uuid
   partition_name="$1"
   lsblk_output="$(lsblk --raw --noheadings --output NAME,UUID)"
   while read -r name uuid; do
      if [ "${name}" = "${partition_name}" ]; then
         printf '%s\n' "${uuid}"
         return 0
      fi
   done <<< "${lsblk_output}"
}

newest-kernel-version() {
   ## Print the version of the NEWEST kernel from a newline-separated /boot
   ## listing.
   local listing newest
   listing="$1"
   newest="$(printf '%s\n' "${listing}" | grep '^vmlinuz-' | sort --version-sort | tail --lines=1)" || true
   printf '%s\n' "${newest#vmlinuz-}"
}

username-plain-for-sudoers() {
   ## True when NAME is safe to interpolate verbatim into a sudoers rule. Names
   ## that are not valid user account names or that sudo will treat as an alias
   ## are rejected.
   local candidate LC_ALL=C
   candidate="$1"
   if [[ "${candidate}" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
      return 1
   fi
   check_valid_linux_user_account_name "${candidate}"
}

derive_unified_image_paths() {
   ## Derive the single "other VM" image path for a multi-VM build. Note that
   ## when used with a Whonix build, the Gateway build is not considered
   ## multi-VM but the Workstation build is.
   local vm_name_item_to_be_exported vm_name_item_lower dist_build_type_long_lower

   if [ "${vm_names_to_be_exported:-}" = "none" ]; then
      return 0
   fi

   # shellcheck disable=SC2086
   for vm_name_item_to_be_exported in ${vm_names_to_be_exported} ; do
      vm_name_item_lower="${vm_name_item_to_be_exported,,}"
      dist_build_type_long_lower="${dist_build_type_long,,}"
      if [[ "${vm_name_item_lower}" == *"${dist_build_type_long_lower}"* ]]; then
         continue
      fi
      default_if_empty binary_image_raw_file_for_unified "${dist_binary_build_folder}/${vm_name_item_to_be_exported}-${dist_build_version}.${target_architecture_pretty_name}.raw"
      default_if_empty binary_image_qcow2_file_for_unified "${dist_binary_build_folder}/${vm_name_item_to_be_exported}-${dist_build_version}.${target_architecture_pretty_name}.qcow2"
   done
}

dist_build_source_config_dir() {
   ## Source every '*.conf' file in a directory.
   local config_dir
   config_dir="${1:-}"
   true "${cyan}INFO: Checking if config dir '${config_dir}' exists...${reset}"
   if [ -d "${config_dir}" ]; then
      true "${cyan}INFO: Parsing '${config_dir}'...${reset}"
      shopt -s nullglob
      local dist_build_config_conf_item
      for dist_build_config_conf_item in "${config_dir}/"*".conf"; do
         bash -n -- "${dist_build_config_conf_item}"
         source "${dist_build_config_conf_item}"
      done
   else
      true "${cyan}INFO: Skipping '${config_dir}' because it does not exist.${reset}"
   fi
}

source_date_epoch_valid() {
   ## Ensure that the given number is valid for SOURCE_DATE_EPOCH.
   local value
   value="$1"
   is_whole_number "${value}" || return 1
   [ "$(( 10#${value} ))" -ge 0 ] && [ "$(( 10#${value} ))" = "${value}" ]
}

value_charset_ok() {
   ## Return 0 if $1 is both non-empty and contains no characters outside of
   ## the charset specified by $2.
   ##
   ## Always return 1 if the charset is empty, since no possible string can
   ## match an empty charset and the character class below would be
   ## unterminated if we used it literally.
   if [ -z "${2:-}" ]; then
      return 1
   fi
   ## shellcheck disable=SC2053
   if [ -z "${1:-}" ] || [[ "${1:-}" == *[!${2:-}]* ]]; then
      return 1
   fi
   return 0
}

unmount_if_mounted() {
   ## Unmount the specified path if it is a mountpoint.
   local mountpoint_rc=0
   ${SUDO_TO_ROOT} mountpoint --quiet -- "$1" || mountpoint_rc="$?"
   case "${mountpoint_rc}" in
      0)
         ## dir is a mountpoint
         ${SUDO_TO_ROOT} umount --verbose -- "$1"
         ;;
      32)
         ## dir is not a mountpoint
         return 0
         ;;
      *)
         ## 'mountpoint' error. Do not fall back to an existence check, it
         ## can say a path doesn't exist if it does but we lack permissions to
         ## check it.
         return "${mountpoint_rc}"
         ;;
   esac
}

## List the ${base}pN device-mapper partition maps for a loop basename on stdout (one per
## line). Returns 'dmsetup ls's OWN exit status: a FAILED or unreadable listing must never be
## mistaken for "no maps left", which would detach the loop under a still-present map (an
## orphan). Callers treat a non-zero return as "maps may remain" and keep the loop attached.
dm_partition_maps() {
   local base_name dm_ls_output dm_ls_rc matched map_item map_deps
   base_name="$1"
   dm_ls_rc=0
   dm_ls_output="$(${SUDO_TO_ROOT} dmsetup ls --noheadings 2>/dev/null)" || dm_ls_rc="$?"
   if [ "${dm_ls_rc}" != "0" ]; then
      return "${dm_ls_rc}"
   fi
   matched="$(printf '%s\n' "${dm_ls_output}" | awk '{ print $1 }' | grep -E "^${base_name}p[0-9]+$" || true)"
   [ -n "${matched}" ] || return 0
   ## OWNERSHIP: emit a ${base}pN map unless it is CONFIRMED backed by a DIFFERENT block device
   ## -- i.e. 'dmsetup deps -o blkdevname' is readable and does NOT name this loop. That excludes
   ## a coincidentally-named foreign map (e.g. a linear map named ${base}p1 backed by /dev/sda1):
   ## never remove it, never let it gate our detach. Unreadable deps -> INCLUDE the map (the
   ## no-orphan guarantee wins; a foreign map with unreadable deps too is doubly unlikely).
   while read -r map_item ; do
      [ -n "${map_item:-}" ] || continue
      map_deps="$(${SUDO_TO_ROOT} dmsetup deps --noheadings -o blkdevname "${map_item}" 2>/dev/null || true)"
      if [ -n "${map_deps}" ]; then
         ## normalise to space-padded alphanumeric tokens, then match the loop's name as a
         ## whole token (so loop0 does not match loop10).
         case " ${map_deps//[^a-zA-Z0-9]/ } " in
            *" ${base_name} "*)
               true "backed by ${base_name}"
               ;;
            *)
               true "INFO: ${map_item} not backed by ${base_name}; skipping foreign map."
               continue
               ;;
         esac
      fi
      printf '%s\n' "${map_item}"
   done <<< "${matched}"
   return 0
}

## True (0) only if a map is CONFIRMED neutralized: its table is readable AND every segment is
## the 'error' target (so it no longer references the loop). A missing/unreadable/empty table,
## or ANY non-error segment, returns non-zero -- the caller then keeps the loop attached rather
## than orphan a map whose table it could not confirm dead.
dm_map_neutralized() {
   local map_name dm_table_output dm_table_rc
   map_name="$1"
   dm_table_rc=0
   dm_table_output="$(${SUDO_TO_ROOT} dmsetup table "${map_name}" 2>/dev/null)" || dm_table_rc="$?"
   if [ "${dm_table_rc}" != "0" ] || [ -z "${dm_table_output:-}" ]; then
      return 1
   fi
   printf '%s\n' "${dm_table_output}" | awk '{ if ($3 != "error") bad = 1 } END { exit (bad ? 1 : 0) }'
}

## True (0) if the map node is MOUNTED. loop_teardown_verify refuses to 'dmsetup remove --force'
## a mounted map: --force loads the 'error' target, which would make a live filesystem's I/O
## fail (corruption). This never blocks the real case -- help-steps/unmount-raw (and the
## build-steps.d/1100_sanity-tests self-test) UNMOUNT before calling loop_teardown_verify, so a
## map still present at the force step is an unmounted gpt-auto open, not a live mount.
dm_map_mounted() {
   findmnt --noheadings --source "/dev/mapper/$1" >/dev/null 2>&1
}

## Release every loop device still associated with an image, then verify the
## image is fully detached. MUST run AFTER the image's filesystems are unmounted
## (help-steps/unmount-raw unmounts first): the --force step error-targets a map, which
## would corrupt a still-mounted filesystem -- dm_map_mounted guards against that.
loop_teardown_verify() {
   local image loop_devices_output loop_devices_item attempt losetup_rc base maps maps_rc map_item still_live
   image="$1"

   if [ "${image:-}" = "" ]; then
      return 1
   fi

   for (( attempt = 0; attempt < 5; attempt++ )); do
      losetup_rc=0
      loop_devices_output="$(${SUDO_TO_ROOT} losetup --associated "${image}" --noheadings --output NAME)" || losetup_rc="$?"
      if [ "${losetup_rc}" != "0" ]; then
         return 1
      fi
      if [ "${loop_devices_output:-}" = "" ]; then
         return 0
      fi
      ## settle first so kpartx -d does not race a udev probe of a partition node
      ${SUDO_TO_ROOT} udevadm settle --timeout 5 || true
      while read -r loop_devices_item ; do
         if [ "${loop_devices_item:-}" = "" ]; then
            continue
         fi
         base="${loop_devices_item##*/}"
         ${SUDO_TO_ROOT} kpartx -d -s -v -- "${loop_devices_item}" || true "INFO: kpartx non-zero exit code."

         ## Layered teardown of any ${base}pN partition map kpartx -d left behind.
         ## kpartx -d RACES a udev/systemd probe of the image's partition signatures and can
         ## report a map "in use. Not removing" though its REAL device-mapper open count is 0;
         ## and the GPT "Linux root x86-64" auto-discovery partition can be auto-opened by the
         ## host with NO removable userspace holder, giving a PERSISTENT open count that does
         ## not clear. (Cannot wrap kpartx in 'udevadm lock': help-steps/udevadm is a no-op
         ## shim during image builds and would swallow the command.) Clear the maps BEFORE
         ## detaching the loop: detaching under a LIVE map orphans it ("Open count:1").
         ## Root cause + proof: https://github.com/org-ai-assisted/kpartx-dmsetup-loop-teardown-busy
         ##
         ## Every map listing is FAIL-CLOSED: a failed 'dmsetup ls' is treated as "maps may
         ## remain" (do not detach, retry), never as "clean".
         ##
         ## 1. dmsetup remove --retry checks the TRUE open count, so it removes a map kpartx
         ##    only false-reported busy (open count 0) while a genuinely-held map survives.
         maps_rc=0
         maps="$(dm_partition_maps "${base}")" || maps_rc="$?"
         if [ "${maps_rc}" != "0" ]; then
            true "INFO: dmsetup ls failed; cannot confirm ${base} maps gone -- leaving loop attached, will retry."
            continue
         fi
         if [ -n "${maps:-}" ]; then
            while read -r map_item ; do
               [ -n "${map_item:-}" ] || continue
               ${SUDO_TO_ROOT} dmsetup remove --retry "${map_item}" || true "INFO: dmsetup remove --retry non-zero exit code."
            done <<< "${maps}"
            maps_rc=0
            maps="$(dm_partition_maps "${base}")" || maps_rc="$?"
            if [ "${maps_rc}" != "0" ]; then
               true "INFO: dmsetup ls failed after --retry -- leaving loop attached, will retry."
               continue
            fi
         fi
         ## 2. A map that SURVIVES has a persistent open count. dmsetup remove --force cannot
         ##    delete an open map, but it loads the 'error' target, which DROPS the map's
         ##    reference to the loop device -- so the loop can be detached without orphaning.
         ##    The lingering error-target node is harmless (no loop ref). REFUSE to force a
         ##    MOUNTED map: error-targeting a live filesystem corrupts it (teardown runs after
         ##    unmount, so a mounted map here is unexpected -- leave it, fail loud).
         if [ -n "${maps:-}" ]; then
            while read -r map_item ; do
               [ -n "${map_item:-}" ] || continue
               if dm_map_mounted "${map_item}"; then
                  true "INFO: ${map_item} is MOUNTED; refusing to force -- leaving loop attached."
                  continue
               fi
               ${SUDO_TO_ROOT} dmsetup remove --force "${map_item}" || true "INFO: dmsetup remove --force non-zero exit code."
            done <<< "${maps}"
         fi
         ## 3. Detach only once every ${base}pN map is gone OR CONFIRMED neutralized to the
         ##    error target. A failed listing, an unreadable table, or ANY live (non-error)
         ##    segment keeps the loop attached (fail-closed) so a live map is never orphaned.
         maps_rc=0
         maps="$(dm_partition_maps "${base}")" || maps_rc="$?"
         if [ "${maps_rc}" != "0" ]; then
            true "INFO: dmsetup ls failed at the detach gate -- leaving loop attached, will retry."
            continue
         fi
         still_live="no"
         if [ -n "${maps:-}" ]; then
            while read -r map_item ; do
               [ -n "${map_item:-}" ] || continue
               if ! dm_map_neutralized "${map_item}"; then
                  still_live="yes"
               fi
            done <<< "${maps}"
         fi
         if [ "${still_live}" = "no" ]; then
            ${SUDO_TO_ROOT} losetup --detach "${loop_devices_item}" || true "INFO: losetup non-zero exit code."
         else
            true "INFO: ${base} partition map(s) still live; leaving loop attached, will retry."
         fi
      done <<< "${loop_devices_output}"
      ${SUDO_TO_ROOT} udevadm settle --timeout 5 || true
      sleep 1
   done

   losetup_rc=0
   loop_devices_output="$(${SUDO_TO_ROOT} losetup --associated "${image}" --noheadings --output NAME)" || losetup_rc="$?"
   if [ "${losetup_rc}" != "0" ]; then
      return 1
   fi
   [ "${loop_devices_output:-}" = "" ]
}

repository_dist_initializer_setup() {
   ## Sets up repository-dist so it is set up properly when the built system
   ## first boots.
   [ -n "${binary_build_folder_dist}" ] || error "repository_dist_initializer_setup: variable binary_build_folder_dist missing!"
   [ -n "${CHROOT_FOLDER}" ] || error "repository_dist_initializer_setup: variable CHROOT_FOLDER missing!"

   ## Enable generation of repository-dist config file
   true "INFO: build_remote_repo_enable: ${build_remote_repo_enable}"
   if [ "${build_remote_repo_enable}" = 'true' ]; then
      printf "%s\n" "${DERIVATIVE_APT_REPOSITORY_OPTS}" | sponge -- "${binary_build_folder_dist}/derivative_apt_repository_opts"

      ## Debugging.
      true "INFO: sudo test"
      ${SUDO_TO_ROOT} test -d /usr

      ${SUDO_TO_ROOT} mkdir --parents -- "${CHROOT_FOLDER}/var/lib/repository-dist/"
      ${SUDO_TO_ROOT} cp -- "${binary_build_folder_dist}/derivative_apt_repository_opts" "${CHROOT_FOLDER}/var/lib/repository-dist/derivative_apt_repository_opts"
   else
      safe-rm --force -- "${binary_build_folder_dist}/derivative_apt_repository_opts"
   fi
}

define_chroot_run() {
   ## Builds the chroot_run function.
   local chroot_env_vars_var_remove_list chroot_env_vars_var_remove_item \
      chroot_env_vars_var_remove_list

   ## Variables removed from the environment before entering a target chroot.
   ## These name host-only state that must not leak into the built image.
   chroot_env_vars_var_remove_list="
      TEMP
      TEMPDIR
      TMP
      TMPDIR
      HELPER_SCRIPTS_PATH
   "

   ## Intentionally not local.
   chroot_remove_env_list=""

   for chroot_env_vars_var_remove_item in ${chroot_env_vars_var_remove_list} ; do
      if [ "${chroot_remove_env_list:-}" = "" ]; then
         chroot_remove_env_list="--unset ${chroot_env_vars_var_remove_item}"
      else
         chroot_remove_env_list+=" --unset ${chroot_env_vars_var_remove_item}"
      fi
   done

   if [ "${dist_build_install_to_root:-}" = "true" ]; then
       chroot_run() {
         ## Not truly unreachable.
         # shellcheck disable=SC2317,SC2086
         ${SUDO_TO_ROOT} "$@"
      }
   else
      chroot_run() {
         ## Not truly unreachable. Word splitting is intentional.
         # shellcheck disable=SC2317,SC2086
         ${SUDO_TO_ROOT} env ${chroot_remove_env_list} -- chroot -- "${CHROOT_FOLDER}" "$@"

         #$SUDO_TO_ROOT env $chroot_remove_env_list systemd-nspawn --directory="$CHROOT_FOLDER"
      }
   fi
}

set_dist_build_reprepro_folder_options() {
   ## Calculates variables related to reprepro when necessary.
   ## TODO: Can we make this a variables.d script that runs unconditionally?

   ## derivative_repository_name gets set by packages/kicksecure/genmkfile/usr/share/genmkfile/make-helper-one.bsh
   local derivative_name_item valid_repository_name
   valid_repository_name=false

   if [ "${derivative_repository_name:-}" = "" ]; then
      error "derivative_repository_name is empty!"
   fi
   true "derivative_repository_name: ${derivative_repository_name}"

   for derivative_name_item in ${derivative_name_list} ; do
      if [ "${derivative_repository_name:-}" = "${derivative_name_item}" ]; then
         valid_repository_name=true
         break
      fi
   done

   if [ ! "${valid_repository_name:-}" = "true" ]; then
      error "derivative_repository_name '${derivative_repository_name}' is invalid! (not in derivative_name_list)"
   fi

   [[ -v make_reprepro_codename_item ]] || make_reprepro_codename_item="${dist_build_apt_codename}"
   true "make_reprepro_codename_item: ${make_reprepro_codename_item}"

   if [ "${make_reprepro_codename_item:-}" = "local" ]; then
      apt_repo_sub_folder="aptrepo_local/${derivative_repository_name}"
   else
      apt_repo_sub_folder="aptrepo_remote/${derivative_repository_name}"
   fi

   dist_apt_repository_folder="${binary_build_folder_dist}/${apt_repo_sub_folder}"
   export dist_apt_repository_folder

   ## Use an array so path components containing whitespace are preserved
   ## correctly.
   dist_build_reprepro_folder_options=(
      --basedir "${source_code_folder_dist}/${apt_repo_sub_folder}"
      --outdir  "${binary_build_folder_dist}/${apt_repo_sub_folder}"
      --dbdir   "${binary_build_folder_dist}/${apt_repo_sub_folder}/db"
      --logdir  "${binary_build_folder_dist}/${apt_repo_sub_folder}/log"
   )
}
