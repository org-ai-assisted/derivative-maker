## This script is executed inside the container and provides basic commands to
## prepare and configure a minimal debian docker image.

set -x
set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

## TODO: root check or use sudo

## Frozen snapshot pin, applied as apt OPTIONS rather than configuration files:
## - Dir::Etc::sourcelist names the ONLY sources file apt reads
## - Dir::Etc::sourceparts=- disables sources.list.d entirely
## so the base image's own sources are simply never consulted; nothing is
## overwritten or blanked.
## - Check-Valid-Until=false because a dated snapshot Release ages past it.
## Matches buildconfig.d/30_apt_opts.conf, which passes the same setting as an
## option for the build.
DM_FROZEN_SOURCES='/etc/apt/dm-frozen.sources'
dm_apt_options=(
   -o "Dir::Etc::sourcelist=${DM_FROZEN_SOURCES}"
   -o 'Dir::Etc::sourceparts=-'
   -o 'Acquire::Check-Valid-Until=false'
)

## The pin is read back out of the file apt is pointed at, because that file is
## the only thing apt obeys; verifying anything else would prove the wrong
## statement. Only 'URIs:' lines count -- comment prose carries example dates.
## Every URI token of every 'URIs:' field, one per line -- including deb822 FOLDED
## continuation lines (a field may continue on lines beginning with whitespace).
## Matching only the 'URIs:' line itself misses those, leaving a URI hidden on a
## continuation line unvalidated.
dm_deb822_uris() {
   local line trimmed token in_field
   in_field=false
   while IFS= read -r line; do
      trimmed="${line#"${line%%[![:space:]]*}"}"
      case "${trimmed}" in
         URIs:*)
            in_field=true
            trimmed="${trimmed#URIs:}"
            ;;
         '')
            in_field=false
            continue
            ;;
         *)
            if [ "${in_field}" = "true" ] && [ ! "${line}" = "${trimmed}" ]; then
               true
            else
               in_field=false
               continue
            fi
            ;;
      esac
      ## Deliberate word splitting: a URIs field is whitespace-separated.
      # shellcheck disable=SC2086
      for token in ${trimmed}; do
         printf '%s\n' "${token}"
      done
   done < "$1"
}

DM_FROZEN_SNAPSHOT="$(dm_deb822_uris "${DM_FROZEN_SOURCES}" \
   | grep -oE '[0-9]{8}T[0-9]{6}Z' | sort --unique | head -n 1 || true)"
dm_frozen_snapshot_count="$(dm_deb822_uris "${DM_FROZEN_SOURCES}" \
   | grep -oE '[0-9]{8}T[0-9]{6}Z' | sort --unique | grep --count . || true)"

## Exactly one snapshot, or the two archives resolve to different ones and the
## security archive can sit silently on an older snapshot.
if [ ! "${dm_frozen_snapshot_count}" = "1" ]; then
   printf '%s\n' \
      "${BASH_SOURCE[0]}: ERROR: expected exactly one pinned snapshot in '${DM_FROZEN_SOURCES}', found ${dm_frozen_snapshot_count}." >&2
   exit 1
fi
## Counting DISTINCT TIMESTAMPS is not the same as validating the URIs. A stanza
## listing the pinned snapshot alongside a live archive
## ('URIs: http://snapshot.../<pin> https://deb.debian.org/debian') yields exactly
## one timestamp and passed the count test, while apt still fetched from the live
## archive -- defeating the pin this check exists to prove. So require EVERY URI
## to carry the snapshot.
dm_unpinned_uri="$(dm_deb822_uris "${DM_FROZEN_SOURCES}" \
   | grep -vE '[0-9]{8}T[0-9]{6}Z' | head -n 1 || true)"
if [ -n "${dm_unpinned_uri}" ]; then
   printf '%s\n' \
      "${BASH_SOURCE[0]}: ERROR: '${DM_FROZEN_SOURCES}' lists URI '${dm_unpinned_uri}', which carries no snapshot timestamp; apt would fetch from it unpinned." >&2
   exit 1
fi

if [ -z "${DM_FROZEN_SNAPSHOT}" ]; then
   printf '%s\n' "${BASH_SOURCE[0]}: ERROR: no pinned snapshot in '${DM_FROZEN_SOURCES}'." >&2
   exit 1
fi

apt-get "${dm_apt_options[@]}" update

## TODO: remove
## 'build-steps.d/1100_sanity-tests' function 'check_required_packages_installed' already installs
## '$required_packages_list' which contains packages such as 'approx'. Any missing packages should
## be installed using 'build-steps.d/1100_sanity-tests' not using docker.
## This is difficult, because 'build-steps.d/1100_sanity-tests' assumes some
## dependencies like 'sudo' are already installed. 'ca-certificates' may also
## be required before packages can be installed in some configurations.
## TODO: Debian forky: gpg-from-sq gpgv-from-sq
## Docker is only used on the HOST: derivative-maker-docker-run drives the
## container from outside; nothing inside the build image ever invokes docker.
## So the docker engine + client are installed only in the host context (see
## the 'USER = root' block below), not when building the image (USER=user via
## the Dockerfile ENV), keeping the image slim. On trixie both packages are
## needed: 'docker-cli' ships the client (/usr/bin/docker) and 'docker.io' the
## daemon (dockerd); with '--no-install-recommends' neither pulls the other.

## Pin the 'approx' system user/group to fixed ids BEFORE installing the
## 'approx' package (its postinst reuses a pre-existing 'approx' account), so
## the apt-cache bind-mount chown target stays correct regardless of Debian's
## dynamic system-uid allocation order. These ids must match the '101:102'
## chown in 'derivative-maker-docker-run' (volume_prepare) and
## 'ci/approx-cache-sidecar'. Uses 'groupadd'/'useradd' from the base image's
## 'passwd' package because 'adduser' is installed in the apt-get call below.
getent group approx >/dev/null || groupadd --system --gid 102 approx
getent passwd approx >/dev/null \
  || useradd --system --gid 102 --uid 101 --no-create-home --home-dir /var/lib/approx --shell /usr/sbin/nologin approx

DEBIAN_FRONTEND=noninteractive \
  apt-get "${dm_apt_options[@]}" install \
    --no-install-recommends \
    --yes \
    sq sqv sqop sequoia-git sequoia-chameleon-gnupg gpg-agent \
    signify-openbsd moreutils \
    dbus dbus-user-session git time curl lsb-release fakeroot \
    dpkg-dev fasttrack-archive-keyring safe-rm adduser sudo approx \
    python3 python3-yaml

## Branch on the run context: docker is only used on the HOST, while the build
## user only exists in the IMAGE. 'sudo' resets USER to 'root' on the host (see
## 'help-steps/dm-build-official-one' CI branch); the Dockerfile ENV sets
## USER=user during the image build.
## ca-certificates is installed SEPARATELY with --reinstall. It is already present
## at this point -- apt-bootstrap-ca-certificates installed it from the base
## image's own (unpinned) sources so https to the snapshot could be validated at
## all. A plain 'apt-get install ca-certificates' is then a no-op whenever the
## live archive and the snapshot carry the same version, which is the normal case:
## apt reports "already the newest version" and fetches nothing, so the trust
## store in the image stays the one that came from the unpinned fetch. --reinstall
## forces it to be re-fetched from the pinned snapshot, which is what makes the
## trust store's provenance match the rest of the image.
DEBIAN_FRONTEND=noninteractive \
   apt-get "${dm_apt_options[@]}" install \
      --no-install-recommends \
      --reinstall \
      --yes \
      ca-certificates

if [ "${USER}" = "root" ]; then
   ## Host: install the docker engine + client (see the comment above the
   ## apt-get call). Never needed inside the image.
   DEBIAN_FRONTEND=noninteractive \
      apt-get "${dm_apt_options[@]}" install \
         --no-install-recommends \
         --yes \
         docker.io docker-cli
else
   ## Image: create the derivative build account + passwordless sudo drop-in.
   ## Creating user 'root' or a 'root ALL=(ALL) NOPASSWD:ALL' drop-in on the
   ## host would be pointless and confusing. The image sets DM_UID via ENV
   ## (Dockerfile); CI overrides it with --build-arg DM_UID=$(id -u) so the
   ## container user matches the host runner; fall back to 1000 for local use.
   [ -v DM_UID ] || DM_UID=1000
   adduser --quiet --disabled-password --uid "${DM_UID}" --home "${HOME}" --gecos "${USER},,,," "${USER}"
   printf '%s\n' "${USER} ALL=(ALL) NOPASSWD:ALL" | tee -- /etc/sudoers.d/passwordless_sudo >/dev/null
   chmod 440 -- /etc/sudoers.d/passwordless_sudo
fi

apt-get clean

safe-rm -r -f -- /var/lib/apt/lists/* /var/cache/apt/*
