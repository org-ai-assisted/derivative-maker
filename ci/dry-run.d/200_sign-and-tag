## AI-Assisted

## signing-key-create refuses to run as root, so drop to builder.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

target_user=builder

cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../.."

## sign-and-tag defaults off; opt in via the env prefix so it survives
## run-as-user's 'sudo --preserve-env=PATH' privilege drop. A dry-run reproduces
## the redistributable build, whose git_sanity_test requires the tree be signed
## (300_run-derivative-maker asserts the buildinfo carries recorded provenance).
./help-steps/run-as-user --chown /workspace -- "${target_user}" \
   env dist_build_sign_and_tag=true ./help-steps/sign-and-tag
