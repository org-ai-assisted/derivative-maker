## AI-Assisted

## signing-key-create refuses to run as root, so drop to builder.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

target_user=builder

cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../.."

## sign-and-tag defaults off; this step exists to exercise it, so opt in
## explicitly (injected past run-as-user's privilege drop via env).
./help-steps/run-as-user --chown /workspace -- "${target_user}" \
   env dist_build_sign_and_tag=true ./help-steps/sign-and-tag
