## Contract check: approx's curlrc files MUST retry transient upstream
## failures. snapshot.debian.org returns per-file 404 / 5xx / timeout
## under load even for files its own Packages index guarantees; without
## retry, one blip makes approx hand apt a 404 and aborts the whole
## cowbuilder create. --retry-all-errors is mandatory (plain --retry
## ignores 404, which is a transient snapshot status). Guards against a
## future edit silently dropping the retry directives.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## CI guard, matching the sibling ci/lint-* scripts: refuse outside CI
## unless ALLOW_LOCAL=true. ci/local-checks sets it.
if [ "${CI:-}" != "true" ] && [ "${ALLOW_LOCAL:-}" != "true" ]; then
  printf '%s\n' "${BASH_SOURCE[0]}: refusing to run outside CI (CI != 'true'). Set ALLOW_LOCAL=true to override." >&2
  exit 1
fi

cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." || exit 2

## Every curlrc approx reads must carry these. Both the clearnet and the
## Tor variant fetch from snapshot.debian.org.
required=( '--retry' '--retry-all-errors' )
curlrc_files=( approx/curlrc approx/curlrc-tor )

rc=0
for curlrc_file in "${curlrc_files[@]}" ; do
  if [ ! -f "${curlrc_file}" ]; then
    printf '%s\n' "ERROR: ${curlrc_file}: missing." >&2
    rc=1
    continue
  fi
  for directive in "${required[@]}" ; do
    ## Anchor to line start (curl config directive), tolerate trailing args.
    if ! grep --quiet -E "^${directive}([[:space:]]|\$)" -- "${curlrc_file}" ; then
      printf '%s\n' "ERROR: ${curlrc_file}: missing required directive '${directive}'." >&2
      rc=1
    fi
  done
done

if (( rc != 0 )); then
  printf '%s\n' "FAILED: approx curlrc retry contract violated." >&2
  exit 1
fi

printf '%s\n' "OK: approx curlrc retry contract satisfied."
