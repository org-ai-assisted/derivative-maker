## AI-Assisted

## Record sha512 of each built VirtualBox .ova as build evidence: write them to
## 'ova-sha512.txt' in the workspace (uploaded as its own artifact) and echo them
## to the job log. Kept as a ci/ script (github-actions-security.md rule 7) so this
## shell is shellcheck / 'bash -n' covered and runnable locally. The Whonix vbox
## dispatch is the only producer of .ova files in this lane.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## Where docker/derivative-maker-docker-run bind-mounts binary_build_folder_dist
## on the runner; the .ova(s) land under it.
binary_mnt="/home/runner/binary_mnt"

out="ova-sha512.txt"

## Read-only over the build output; write the evidence into the workspace, not
## next to the (in-container-uid-owned) .ova, so no chown dance is needed.
##
## Capture before iterating (bash-style R-016): a 'done < <(find ...)' process
## substitution runs find in a subshell whose exit status the loop never sees,
## so a failed producer would read as an empty list rather than an error. .ova
## names are dm-generated (no newlines), so a newline-split readarray is safe.
ova_listing="$(find "${binary_mnt}" -type f -name '*.ova' | sort)"
ova_list=()
[ -z "${ova_listing}" ] || readarray -t ova_list <<< "${ova_listing}"

if [ "${#ova_list[@]}" -eq 0 ]; then
   printf '%s\n' "${BASH_SOURCE[0]}: no .ova found under ${binary_mnt}" >&2
   exit 1
fi

sha512sum -- "${ova_list[@]}" | tee -- "${out}"

printf '%s\n' "${BASH_SOURCE[0]}: recorded sha512 for ${#ova_list[@]} .ova file(s) in ${out}"
