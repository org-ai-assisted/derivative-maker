#!/bin/bash

## Copyright (C) 2012 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## Parses command-line arguments and reads configuration files.

## style-ok: no-strict -- sourced fragment.
# shellcheck disable=SC1090,SC2086

if [ ! "${dist_build_one_parsed:-}" = "true" ]; then
   bash -n -- "${source_code_folder_dist}/help-steps/parse-cmd"
   source "${source_code_folder_dist}/help-steps/parse-cmd"
   dist_build_one_parse_cmd "$@"
   ## NOT exported: same-shell idempotency guard only. Exporting leaks the
   ## parse-skip into child build-step PROCESSES, which then skip validating
   ## their OWN argv -- an unknown flag is silently ignored, and --function is
   ## dropped so ALL packages build instead of the named one. Every process
   ## re-parses its own complete argv (the main flow forwards full args), so
   ## re-parse is idempotent.
   dist_build_one_parsed="true"
fi

## Derive the per-build scratch/output root HERE: after parse-cmd (so --build-slot on the command
## line, not just a dist_build_slot env var, takes effect) but BEFORE the config files below, which
## may REFERENCE binary_build_folder_dist / dist_aptgetopt_file -- sourcing a config under
## 'set -o nounset' that reads an unset one would abort the build. (This matches the long-standing
## position relative to config: these were previously derived in 00_preamble, also before config.)
## DELIBERATE: a config file that OVERRIDES binary_build_folder_dist does NOT re-point the derived
## dist_aptgetopt_file or re-lane a config-set dist_build_slot -- same as the long-standing behavior;
## a config redirects the tree via binary_build_folder_dist directly. Keep this simple; do not add a
## post-config re-derive (it was tried and reverted as needless complexity).
## --build-slot NAME (env: dist_build_slot) scopes the WHOLE per-build tree -- output tree, the
## _image chroot (10_misc CHROOT_FOLDER), the local apt repo, the tag-verify temp, the cowbuilder
## base all derive from binary_build_folder_dist -- so one slot isolates them all and builds that
## share a $HOME (several sessions as one user on a shared host) run concurrently without colliding.
export dist_build_slot="${dist_build_slot:-}"
if [ -n "${binary_build_folder_dist:-}" ]; then
   true "INFO: using explicitly set binary_build_folder_dist='${binary_build_folder_dist}'"
elif [ -n "${dist_build_slot}" ]; then
   binary_build_folder_dist="${HOMEVAR}/derivative-binary/${dist_build_slot}"
else
   binary_build_folder_dist="${HOMEVAR}/derivative-binary"
fi
export binary_build_folder_dist

## pbuilder word-splits bind-mount paths; reject internal whitespace.
for space_check_var in HOMEVAR binary_build_folder_dist source_code_folder_dist ; do
   if [[ "${!space_check_var}" == *[[:space:]]* ]]; then
      error "${space_check_var} must not contain whitespace, as pbuilder will word-split it. Variable contents: '${!space_check_var}'"
   fi
done
unset space_check_var

default_if_empty dist_aptgetopt_file "${binary_build_folder_dist}/30_derivative-maker.conf"
export dist_aptgetopt_file

## All files can be sourced at once here, no need to handle the repo-local config later.
default_if_empty dist_build_config_dirs_list "${source_code_folder_dist}/buildconfig.d /etc/buildconfig-dist.d ${HOMEVAR}/buildconfig.d"
for dist_build_config_dir_item in ${dist_build_config_dirs_list}; do
   dist_build_source_config_dir "${dist_build_config_dir_item}"
done
unset dist_build_config_dir_item
if [ ! "${dist_build_custom_config_dir:-}" = "" ]; then
   dist_build_source_config_dir "${dist_build_custom_config_dir}"
fi
if [ ! "${dist_build_conf_file:-}" = "" ]; then
   if [ -f "${dist_build_conf_file}" ]; then
      bash -n -- "${dist_build_conf_file}"
      source "${dist_build_conf_file}"
   fi
fi
